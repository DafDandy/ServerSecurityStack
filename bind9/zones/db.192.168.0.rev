$TTL 3600
@       IN      SOA     ns1.federationofdaf.com. admin.federationofdaf.com. (
                        2026041001      ; Serial
                        3600            ; Refresh
                        1800            ; Retry
                        604800          ; Expire
                        3600            ; Minimum TTL
                        )

; Nameserver
@       IN      NS      ns1.federationofdaf.com.

; Reverse DNS entries
; Format: last-octet    IN  PTR     hostname.domain.
10      IN      PTR     ns1.federationofdaf.com.
10      IN      PTR     federationofdaf.com.
10      IN      PTR     auth.federationofdaf.com.
10      IN      PTR     traefik.federationofdaf.com.
10      IN      PTR     homepage.federationofdaf.com.